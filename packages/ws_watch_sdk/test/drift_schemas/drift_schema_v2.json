  "fixed_sql": [
    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"device_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"bt_mac\" TEXT NULL, \"firmware_version\" TEXT NULL, \"device_info_raw\" BLOB NULL, \"capabilities_raw\" BLOB NULL, \"chip_type\" INTEGER NULL, \"last_connected_at\" INTEGER NULL, PRIMARY KEY (\"device_id\"));"
        }
      ]
    },
    {
      "name": "step_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"step_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"device_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"record_time\" INTEGER NOT NULL, \"mode\" INTEGER NOT NULL, \"steps\" INTEGER NULL, \"bucket_minutes\" INTEGER NOT NULL, \"average_heart_rate\" INTEGER NULL, \"flags\" INTEGER NOT NULL, \"calories_deci_kcal\" INTEGER NULL, \"distance_meters\" INTEGER NULL, \"tz_offset_minutes\" INTEGER NOT NULL, \"synced_at\" INTEGER NOT NULL, \"raw\" BLOB NOT NULL, UNIQUE (\"device_id\", \"user_id\", \"record_time\"));"
        }
      ]
    },
    {
      "name": "heart_rate_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"heart_rate_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"device_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"record_time\" INTEGER NOT NULL, \"bpm\" INTEGER NULL, \"source_key\" INTEGER NOT NULL, \"tz_offset_minutes\" INTEGER NOT NULL, \"synced_at\" INTEGER NOT NULL, \"raw\" BLOB NOT NULL, UNIQUE (\"device_id\", \"user_id\", \"record_time\"));"
        }
      ]
    },
    {
      "name": "sync_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"device_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"sync_id\" TEXT NOT NULL UNIQUE, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NOT NULL, \"announced_json\" TEXT NOT NULL, \"received_json\" TEXT NOT NULL, \"device_result_code\" INTEGER NULL, \"confirmation\" TEXT NOT NULL, \"result\" TEXT NOT NULL, \"reason\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "step_device_time",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX step_device_time ON step_records (device_id, record_time)"
        }
      ]
    },
    {
      "name": "heart_device_time",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX heart_device_time ON heart_rate_records (device_id, record_time)"
        }
      ]
    },
    {
      "name": "sync_device_started",
